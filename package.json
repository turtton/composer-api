{
  "name": "composer-api",
  "version": "0.1.0",
  "private": false,
  "packageManager": "pnpm@10.12.1",
  "description": "Local OpenCode-compatible API proxy for Cursor Composer.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/standardagents/composer-api.git"
  },
  "homepage": "https://github.com/standardagents/composer-api#readme",
  "bugs": {
    "url": "https://github.com/standardagents/composer-api/issues"
  },
  "scripts": {
    "start": "tsx scripts/opencode-local-server.ts",
    "dev": "tsx scripts/opencode-local-server.ts",
    "opencode:run": "tsx scripts/opencode-run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:opencode": "bash scripts/test-opencode-websearch.sh",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cursor",
    "composer",
    "opencode",
    "openai",
    "chat-completions"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
