# Cursor backend (required)
CURSOR_BACKEND_BASE_URL="https://api2.cursor.sh"
CURSOR_LOCAL_AGENT_ENDPOINT="/agent.v1.AgentService/Run"

# Legacy /opencode/v1 route only (optional)
CURSOR_CHAT_ENDPOINT="/aiserver.v1.ChatService/StreamUnifiedChatWithTools"

# Local server (optional)
COMPOSER_API_HOST="127.0.0.1"
COMPOSER_API_PORT="8787"
# Close hung OpenCode HTTP requests after this many ms (0 disables)
COMPOSER_API_REQUEST_TIMEOUT_MS="130000"

# Cursor SDK stream timeouts (optional, milliseconds)
# CURSOR_SDK_STREAM_START_TIMEOUT_MS="25000"
# CURSOR_SDK_STREAM_IDLE_TIMEOUT_MS="60000"
# CURSOR_SDK_RUN_TIMEOUT_MS="120000"
# CURSOR_SDK_BRIDGE_REQUEST_TIMEOUT_MS="120000"

# OpenCode uses this as the Bearer token (set in your shell, not here)
# CURSOR_API_KEY="crsr_..."
