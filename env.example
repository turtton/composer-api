# Cursor backend base URL (the main Cursor API origin)
CURSOR_BACKEND_BASE_URL=

# Cursor local agent endpoint path or full URL
CURSOR_LOCAL_AGENT_ENDPOINT=

# Optional: SDK client version (default: sdk-1.0.13)
# CURSOR_SDK_CLIENT_VERSION=sdk-1.0.13

# Optional: Server port (default: 3000)
# PORT=3000

# Optional: Server bind host (default: 0.0.0.0)
# HOST=0.0.0.0
